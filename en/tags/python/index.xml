&lt;div style="display:flex;flex-wrap:wrap;gap:6px;margin:1.2rem 0 1.8rem;">
&lt;a href="https://github.com/dewiweb/clock_X_overlay" target="_blank" style="text-decoration:none;">
&lt;img src="https://img.shields.io/github/stars/dewiweb/clock_X_overlay?style=flat-square&amp;logo=github&amp;color=6366f1&amp;labelColor=1e1e2e" alt="GitHub stars" />
&lt;/a>
